# EditorConfig — https://editorconfig.org
# Ensures consistent formatting across editors (VS Code, WebStorm, Vim, etc.)

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
max_line_length = 80

[*.json]
indent_size = 2

[*.yaml]
indent_size = 2

[Makefile]
indent_style = tab

[*.css]
indent_size = 2
