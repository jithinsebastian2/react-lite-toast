{
  "name": "@react-lite-toast/react",
  "version": "0.1.0",
  "description": "React renderer, components, and hooks for react-lite-toast",
  "keywords": [
    "toast",
    "notification",
    "react",
    "react18",
    "react19",
    "hooks",
    "accessible",
    "headless"
  ],
  "homepage": "https://github.com/jithinsebastian2/react-lite-toast#readme",
  "bugs": {
    "url": "https://github.com/jithinsebastian2/react-lite-toast/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jithinsebastian2/react-lite-toast.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": "jithinsebastian2",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/styles/index.css",
    "./styles/base": "./dist/styles/base.css",
    "./styles/animations": "./dist/styles/animations/index.css",
    "./styles/themes": "./dist/styles/themes/index.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage .tsbuildinfo"
  },
  "dependencies": {
    "@react-lite-toast/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "vite": "^5.4.8",
    "vite-plugin-dts": "^4.2.4",
    "vitest": "^2.1.1",
    "@vitest/coverage-v8": "^2.1.1"
  }
}
